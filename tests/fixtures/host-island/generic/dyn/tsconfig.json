{
  // The fixtures compile like a Vite web app: browser libs, and the project declarations under "include" (node-env.d.ts:
  // Node's types, the compiled console, as a Vite app's vite-env.d.ts brings them).
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "dom", "dom.iterable"],
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["."]
}
