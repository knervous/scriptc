{
  "name": "scriptw",
  "version": "0.2.0",
  "private": true,
  "description": "Compile TypeScript and JavaScript to WasmGC modules with no native toolchain",
  "license": "Apache-2.0",
  "keywords": [
    "typescript",
    "javascript",
    "webassembly",
    "wasm",
    "wasmgc",
    "compiler",
    "aot",
    "browser"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./host": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.mjs"
    },
    "./int": {
      "wasmgc": "./intrinsics/int.ts",
      "types": "./intrinsics/int.d.ts",
      "default": "./intrinsics/int.mjs"
    },
    "./math": {
      "wasmgc": "./intrinsics/math.ts",
      "types": "./intrinsics/math.d.ts",
      "default": "./intrinsics/math.mjs"
    },
    "./layout": {
      "wasmgc": "./intrinsics/layout.ts",
      "types": "./intrinsics/layout.d.ts",
      "default": "./intrinsics/layout.mjs"
    },
    "./f16": {
      "wasmgc": "./intrinsics/f16.ts",
      "types": "./intrinsics/f16.d.ts",
      "default": "./intrinsics/f16.engine.mjs"
    },
    "./atomics": {
      "wasmgc": "./intrinsics/atomics.ts",
      "types": "./intrinsics/atomics.d.ts",
      "default": "./intrinsics/atomics.mjs"
    },
    "./simd": {
      "wasmgc": "./intrinsics/simd.ts",
      "types": "./intrinsics/simd.d.ts",
      "default": "./intrinsics/simd.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "scriptw": "bin/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assemble": "node scripts/assemble.mjs",
    "smoke": "node test/smoke.mjs",
    "test:browser": "node test/browser.mjs"
  },
  "companions": [
    "@scriptw/llvm-linux-x64-gnu",
    "@scriptw/llvm-win32-x64",
    "@scriptw/llvm-darwin-arm64",
    "@scriptw/llvm-darwin-x64",
    "@scriptw/runtime-linux-x64-gnu",
    "@scriptw/runtime-win32-x64",
    "@scriptw/runtime-darwin-arm64",
    "@scriptw/runtime-darwin-x64",
    "@scriptw/runtime-android-arm64",
    "@scriptw/host-linux-x64-gnu",
    "@scriptw/host-win32-x64",
    "@scriptw/host-darwin-arm64",
    "@scriptw/host-darwin-x64",
    "@scriptw/host-android-arm64"
  ]
}
