{
  "name": "scriptw",
  "version": "0.1.0",
  "private": true,
  "description": "Compile TypeScript and JavaScript to WasmGC modules with no native toolchain",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "scriptw": "bin/cli.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "assemble": "node scripts/assemble.mjs",
    "smoke": "node test/smoke.mjs"
  },
  "optionalDependencies": {
    "@scriptw/llvm-linux-x64-gnu": "0.1.0",
    "@scriptw/llvm-win32-x64": "0.1.0",
    "@scriptw/llvm-darwin-arm64": "0.1.0",
    "@scriptw/llvm-darwin-x64": "0.1.0",
    "@scriptw/runtime-linux-x64-gnu": "0.1.0",
    "@scriptw/runtime-win32-x64": "0.1.0",
    "@scriptw/runtime-darwin-arm64": "0.1.0",
    "@scriptw/runtime-darwin-x64": "0.1.0",
    "@scriptw/runtime-android-arm64": "0.1.0",
    "@scriptw/host-linux-x64-gnu": "0.1.0",
    "@scriptw/host-win32-x64": "0.1.0",
    "@scriptw/host-darwin-arm64": "0.1.0",
    "@scriptw/host-darwin-x64": "0.1.0",
    "@scriptw/host-android-arm64": "0.1.0"
  }
}
